/*
 *
 *  Hardware :
 *    - ESP32
 *    - MPU6050  (I2C  → SDA=19, SCL=18)
 *    - MQ-3     (Analog → GPIO 34)
 *    - SW-420   (Digital → GPIO 27)
 *    - Buzzer   (Digital → GPIO 25)
 *
 *  Sensors send data to ESP32 → threshold evaluation
 *  → Buzzer (local) + Telegram notification (remote)
 * ============================================================
 */

// ── Libraries ───────────────────────────────────────────────
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <math.h>

